{
  "name": "reqbook-vscode",
  "displayName": "Reqbook",
  "description": "Preview, validate, run, and inspect Reqbook API specs from VS Code.",
  "version": "0.1.0",
  "publisher": "reqbook",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ngoclinh93qt/ReqBook.git",
    "directory": "packages/vscode"
  },
  "homepage": "https://docs.markapidown.net/guides/vscode-extension",
  "bugs": {
    "url": "https://github.com/ngoclinh93qt/ReqBook/issues"
  },
  "icon": "icon.png",
  "preview": true,
  "qna": false,
  "files": [
    "CHANGELOG.md",
    "detect.js",
    "extension.js",
    "icon.png",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "api",
    "markdown",
    "testing",
    "http",
    "openapi",
    "agent"
  ],
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Reqbook runs the local rqb binary and may execute HTTP requests from workspace specs."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Reqbook requires real workspace files and a local rqb binary."
    }
  },
  "activationEvents": [
    "onLanguage:markdown",
    "workspaceContains:api-docs/reqbook.md",
    "workspaceContains:api-docs/mad.md",
    "onCommand:reqbook.previewEndpoint",
    "onCommand:reqbook.runSpec",
    "onCommand:reqbook.runEndpoint",
    "onCommand:reqbook.validateFile",
    "onCommand:reqbook.showContext"
  ],
  "main": "./extension.js",
  "scripts": {
    "check": "node -c extension.js",
    "test": "node --test test/*.test.js",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "contributes": {
    "commands": [
      {
        "command": "reqbook.previewEndpoint",
        "title": "Reqbook: Preview Endpoint"
      },
      {
        "command": "reqbook.runSpec",
        "title": "Reqbook: Run Spec"
      },
      {
        "command": "reqbook.validateFile",
        "title": "Reqbook: Validate Current File"
      },
      {
        "command": "reqbook.showContext",
        "title": "Reqbook: Show Agent Context"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "reqbook.runSpec",
          "when": "reqbook.runnableSpec && resourceLangId == markdown",
          "group": "navigation@80"
        },
        {
          "command": "reqbook.previewEndpoint",
          "when": "resourceLangId == markdown",
          "group": "navigation@81"
        }
      ],
      "editor/context": [
        {
          "command": "reqbook.validateFile",
          "when": "resourceLangId == markdown",
          "group": "reqbook@1"
        },
        {
          "command": "reqbook.runSpec",
          "when": "reqbook.runnableSpec && resourceLangId == markdown",
          "group": "reqbook@2"
        },
        {
          "command": "reqbook.showContext",
          "when": "resourceLangId == markdown",
          "group": "reqbook@3"
        }
      ],
      "commandPalette": [
        {
          "command": "reqbook.previewEndpoint"
        },
        {
          "command": "reqbook.runSpec"
        },
        {
          "command": "reqbook.validateFile"
        },
        {
          "command": "reqbook.showContext"
        }
      ]
    },
    "configuration": {
      "title": "Reqbook",
      "properties": {
        "reqbook.rqbPath": {
          "type": "string",
          "default": "rqb",
          "description": "Path to the rqb binary used by the extension."
        },
        "reqbook.env": {
          "type": "string",
          "default": "dev",
          "description": "Default Reqbook environment for run and context commands."
        },
        "reqbook.apiDocsRoot": {
          "type": "string",
          "default": "",
          "description": "Optional api-docs root path. Relative paths are resolved from the workspace root."
        },
        "reqbook.resultPanel": {
          "type": "boolean",
          "default": true,
          "description": "Show command results in the Reqbook result panel."
        }
      }
    }
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0"
  }
}
